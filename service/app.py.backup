from http.server import HTTPServer, BaseHTTPRequestHandler
import subprocess
from pathlib import Path
from html import escape

LOG_FILE = Path("/home/iot/service-recovery-project/logs/recovery.log")
SERVICE = "test-web.service"

class Dashboard(BaseHTTPRequestHandler):
    def do_GET(self):
        status = subprocess.run(
            ["systemctl", "is-active", SERVICE],
            capture_output=True, text=True
        ).stdout.strip()

        if self.path == "/health":
            self.send_response(200 if status == "active" else 503)
            self.end_headers()
            self.wfile.write(status.encode())
            return

        logs = LOG_FILE.read_text()[-5000:] if LOG_FILE.exists() else "No recovery logs yet."
        logs = escape(logs)
        page = f"""
        <!DOCTYPE html>
        <html>
        <head>
            <title>Service Recovery Dashboard</title>
            <meta http-equiv="refresh" content="10">
            <style>
                body {{ font-family: Arial; background: #f1f5f9; margin: 40px; }}
                .card {{ background: white; padding: 22px; margin-bottom: 20px;
                         border-radius: 10px; box-shadow: 0 2px 8px #ccc; }}
                h1 {{ color: #1e293b; }}
                pre {{ background: #0f172a; color: #e2e8f0; padding: 15px;
                       border-radius: 8px; white-space: pre-wrap; }}
                .status {{ font-size: 22px; font-weight: bold;
                           color: {"green" if status == "active" else "red"}; }}
            </style>
        </head>
        <body>
            <h1>Linux Service Recovery Dashboard</h1>
            <div class="card">
                <h2>Service Status</h2>
                <p>Service: {SERVICE}</p>
                <p class="status">{status.upper() if status else "UNKNOWN"}</p>
                <p>Dashboard refreshes every 10 seconds.</p>
            </div>
            <div class="card">
                <h2>Recovery Logs</h2>
                <pre>{logs}</pre>
            </div>
        </body>
        </html>
        """

        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()
        self.wfile.write(page.encode())

HTTPServer(("0.0.0.0", 8080), Dashboard).serve_forever()
